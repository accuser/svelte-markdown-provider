		"@accuser/svelte-mdast": "github:accuser/svelte-mdast",
		"@accuser/svelte-mdast-directive": "github:accuser/svelte-mdast-directive",
		"@accuser/svelte-mdast-gfm": "github:accuser/svelte-mdast-gfm",
		"@accuser/svelte-mdast-math": "github:accuser/svelte-mdast-math",
		"@accuser/svelte-unist": "github:accuser/svelte-unist",
		"@types/hast": "^3.0.4",
		"@types/mdast": "^4.0.4",
		"@types/unist": "^3.0.3",
		"github-slugger": "^2.0.0",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-from-markdown": "^2.0.2",
		"mdast-util-frontmatter": "^2.0.1",
		"mdast-util-to-string": "^4.0.0",
		"mdast-util-toc": "^7.1.0",
		"micromark-extension-directive": "^4.0.0",
		"micromark-extension-frontmatter": "^2.0.0",
		"micromark-util-types": "^2.0.2",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.46.5",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.14",
		"@testing-library/jest-dom": "^6.9.1",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.7.2",
		"@typescript-eslint/eslint-plugin": "^8.46.1",
		"@typescript-eslint/parser": "^8.46.1",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.37.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"jsdom": "^27.0.0",
		"mdast-util-gfm": "^3.1.0",
		"mdast-util-math": "^3.0.0",
